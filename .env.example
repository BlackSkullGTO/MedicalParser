# ===== Общие настройки приложения =====
DEBUG=1
# Таймзона приложения (IANA). Влияет на Celery и на сессию PostgreSQL:
# created_at/updated_at (func.now()) отображаются в этой зоне.
TIMEZONE=Europe/Moscow

# ===== PostgreSQL =====
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=parserdb
POSTGRES_USER=parser
POSTGRES_PASSWORD=parser

# ===== Redis =====
REDIS_HOST=localhost
# Порт, по которому Redis доступен с хоста (docker-compose его публикует).
# Если 6379 занят — поменяйте здесь: значение подхватят и compose, и приложение.
REDIS_PORT=6379
REDIS_DB=0

# ===== Docker / entrypoint =====
# Применять миграции Alembic при старте контейнера (1 — да, 0 — нет).
RUN_MIGRATIONS=1

# ===== Отладка Python (debugpy) =====
PYDEVD_THREAD_DUMP_ON_WARN_EVALUATION_TIMEOUT=true
PYDEVD_INTERRUPT_THREAD_TIMEOUT=5000
